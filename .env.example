# Copy this file to .env and fill in the values. Never commit .env.

# Azure AI Foundry (Azure OpenAI endpoint of the resource fdy-docassistant-sb)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment names chosen in Foundry
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding
AZURE_OPENAI_CHAT_DEPLOYMENT=chat

# Azure AI Search (filled in later)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=industrial-docs
